# Folder with your 3D Blu-ray MKVs (MakeMKV rips). Scanned recursively.
MOVIES_DIR=/home/you/Videos/3D
# Audio languages to offer (ISO 639-2: eng, ita, deu, fra...), comma separated.
# Empty = first track only.
AUDIO_LANG=eng
# per-language: one file per language (for players without an audio track menu,
#               like the VITURE 3D Player)
# single:       one file with all the languages (players with an audio menu)
# both:         per-language files + the all-languages file in Multi-audio/
AUDIO_FILES=per-language
# auto = NVENC if available (needs docker-compose.nvidia.yml), else x264 on the CPU
ENCODER=auto
# SMB port on the host. Players on phones/glasses expect 445.
SMB_PORT=445
