# Folder with 3D Blu-ray ISOs, BDMV folders or MKV rips. Scanned recursively.
MOVIES_DIR=/home/you/Videos/3D
# Blu-ray drive to watch (also uncomment the device in docker-compose.yml): the movie
# appears when a 3D disc is inserted. Empty = no drive.
DRIVE=
# Folder containing KEYDB.cfg for libaacs (commercial discs). Not provided by this project.
AACS_DIR=/home/you/.config/aacs
# Folder with vm0/ and convtab/ for libbdplus (BD+ discs). Not provided by this project.
BDPLUS_DIR=/home/you/.config/bdplus
# Audio languages to offer (ISO 639-2: eng, ita, deu, fra...), comma separated.
# Empty or "all" = every language on the disc.
AUDIO_LANG=all
# per-language: one file per language (for players without an audio track menu,
#               like the VITURE 3D Player)
# single:       one file with all the languages (players with an audio menu)
# both:         per-language files + the all-languages file in Multi-audio/
AUDIO_FILES=per-language
# on: every movie also at a lower bitrate in a Light/ folder, for rooms with weak Wi-Fi
LIGHT=on
# subtitle languages offered as extra versions drawn into the picture (ITAsubENG - ...):
# e.g. ita,eng; all or none. Each language adds files: keep it short
SUBS=all
# 3D subtitles: pixels each eye's copy moves inward (more = closer to you, 0 = screen plane)
SUB_DEPTH=8
# animation after a jump: retrowave, simple, none, or a video file (see docs/OPTIONS.md)
LOADER=retrowave
# auto = NVENC if available (needs docker-compose.nvidia.yml), else x264 on the CPU
ENCODER=auto
# SMB port on the host. Players on phones/glasses expect 445.
SMB_PORT=445
# samba (default): mount for Samba, as above. dlna: announce the files over DLNA/UPnP
# instead, for players that browse a media server (TVs, Kodi, Moon VR...). both: do both.
# With Docker, DLNA needs the host network: start with docker-compose.dlna.yml (dlna)
# or docker-compose.both.yml (both) on top of docker-compose.yml, see docs/OPTIONS.md
SHARE=samba
# port of the DLNA/HTTP server (SHARE=dlna/both); 8200 is minidlna's own default,
# avoided here so the two can run on the same host without a clash
HTTP_PORT=8201
