#!/bin/sh
set -e

group=bluray3d-xr
mount=/srv/bd3d
smb_conf=/etc/samba/smb.conf
mark_begin="# >>> bluray3d-xr >>>"
mark_end="# <<< bluray3d-xr <<<"

if ! getent group "$group" >/dev/null; then
    groupadd --system "$group"
fi
install -d -o root -g "$group" -m 2775 "$mount"

# FUSE and Samba are only recommended: --share dlna needs neither. Configure
# them when installed (a later install: dpkg-reconfigure bluray3d-xr)
if [ -f /etc/fuse.conf ] && ! grep -qxF user_allow_other /etc/fuse.conf; then
    printf '%s\n' user_allow_other >> /etc/fuse.conf
fi

[ -f "$smb_conf" ] || exit 0
if grep -qF "$mark_begin" "$smb_conf"; then
    sed -i "/^${mark_begin}\$/,/^${mark_end}\$/d" "$smb_conf"
fi
cat >> "$smb_conf" <<SHARE

$mark_begin
[Disks]
   path = $mount
   comment = Blu-ray and DVD, played on the fly
   read only = yes
   guest ok = yes
   browseable = yes
$mark_end
SHARE

testparm -s >/dev/null
if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null; then
    deb-systemd-invoke reload smbd.service || true
fi
