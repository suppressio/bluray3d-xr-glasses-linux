#!/bin/sh
set -e

mark_begin="# >>> bluray3d-xr >>>"
mark_end="# <<< bluray3d-xr <<<"

case "$1" in
    remove|purge)
        if mountpoint -q /srv/bd3d; then
            fusermount3 -u /srv/bd3d || umount /srv/bd3d || true
        fi
        if grep -qsF "$mark_begin" /etc/samba/smb.conf; then
            sed -i "/^${mark_begin}\$/,/^${mark_end}\$/d" /etc/samba/smb.conf
            if testparm -s >/dev/null 2>&1 &&
                    [ -d /run/systemd/system ] &&
                    command -v deb-systemd-invoke >/dev/null; then
                deb-systemd-invoke reload smbd.service || true
            fi
        fi
        rmdir /srv/bd3d 2>/dev/null || true
        ;;
esac

if [ "$1" = purge ] && getent group bluray3d-xr >/dev/null; then
    groupdel bluray3d-xr || true
fi
